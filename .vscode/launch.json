{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Yept Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--disable-extensions", "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.cjs"],
      "preLaunchTask": "Build Yept extension"
    }
  ]
}
